#: app/Controllers/Api/FetchController.php:46
msgid "Unreachable feed."
msgstr "Flux injoignable."

#: app/Controllers/SetupController.php:116
msgid "Select a database type."
msgstr "Sélectionnez un type de base de données."

#: app/Controllers/SetupController.php:121
msgid "Database host can't be empty."
msgstr "Le serveur de base de données ne peut être vide."

#: app/Controllers/SetupController.php:126
msgid "Database port must be an integer."
msgstr "Le port de la base de données doit être un nombre."

#: app/Controllers/SetupController.php:132
msgid "Database username can't be empty."
msgstr "L'utilisateur de la base de données ne peut être vide."

#: app/Controllers/SetupController.php:143
msgid "Database can't be empty."
msgstr "Le nom de la base de données ne peut être vide."

#: app/Controllers/SetupController.php:149
msgid "User name can't be empty."
msgstr "Le nom de l'utilisateur ne peut être vide."

#: app/Controllers/SetupController.php:153
msgid "User email must be a valid email address."
msgstr "L'adresse email de l'utilisateur doit être une adresse email valide."

#: app/Controllers/SetupController.php:158
msgid "User password can't be empty."
msgstr "Le mot de passe utilisateur ne peut être vide."

#: app/Controllers/SetupController.php:163
msgid "Timezone can't be empty."
msgstr "Le fuseau horaire ne peut être vide."

#: app/Controllers/SetupController.php:173
msgid "Select a mailer driver."
msgstr "Sélectionnez une méthode d'envoi des courriels."

#: app/Controllers/SetupController.php:179
msgid "SMTP host can't be empty."
msgstr "L'adresse du serveur SMTP ne peut être vide."

#: app/Controllers/SetupController.php:184
msgid "SMTP port must be an integer."
msgstr "Le port du serveur SMTP doit être un nombre."

#: app/Controllers/SetupController.php:197
msgid "Mailer \"from\" field must be a valid email address."
msgstr "L'adresse d'expéditeur doit être une adresse de courriel valide."

#: app/Controllers/SetupController.php:198
msgid "Mailer \"from\" field can't be empty for handling registrations."
msgstr ""
"L'adresse d'expéditeur des courriels ne peut être vide pour gérer les "
"inscriptions."

#: app/Controllers/SetupController.php:203
msgid "Mailer \"replyto\" field must be a valid email address."
msgstr "L'adresse pour les réponses doit être une adresse de courriel valide."

#: app/Controllers/SetupController.php:204
msgid "Mailer \"replyto\" field can't be empty for handling registrations."
msgstr ""
"L'adresse de courriel pour les réponses ne peut être vide pour gérer les "
"inscriptions."

